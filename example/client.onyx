#load "./../module"

use websockets { ws :: package }
use core {println}

main :: () {
    res_conn := ws.connect("wss://echo.websocket.org/", "", "echo.websocket.org")
    conn := res_conn!

    conn->recv() |> println()

    while true {
        conn->send("This is a test")
        conn->recv() |> println()
    }
}

